{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Euler execution_receipt 2.0",
  "type": "object",
  "properties": {
    "version": {
      "enum": [
        "2.0"
      ]
    },
    "recipe_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "bound_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "source_full_ids": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^/(?!\\.{1,2}(?:/|$))[^/]+(?:/(?!\\.{1,2}(?:/|$))[^/]+)*(?![\\s\\S])"
      },
      "minProperties": 1,
      "maxProperties": 64
    },
    "source_content": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
      },
      "minProperties": 1
    },
    "input_digests": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
      },
      "minProperties": 1
    },
    "output_digests": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
      },
      "minProperties": 1
    },
    "input_shapes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 2,
        "maxItems": 4
      },
      "minProperties": 1
    },
    "output_shapes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 2,
        "maxItems": 4
      },
      "minProperties": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
          },
          "op": {
            "enum": [
              "euler_loading.resize",
              "euler_loading.crop"
            ]
          },
          "version": {
            "enum": [
              "1.0"
            ]
          },
          "status": {
            "enum": [
              "executed",
              "skipped"
            ]
          },
          "reason": {
            "enum": [
              "applied",
              "identity_size"
            ]
          },
          "input_size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "output_size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "offset": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "image_transform": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "id",
          "op",
          "version",
          "status",
          "reason",
          "input_size",
          "output_size",
          "offset",
          "image_transform"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "execution": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "torch_cpu",
            "pillow_cpu"
          ]
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "minProperties": 1
        },
        "device": {
          "enum": [
            "cpu"
          ],
          "default": "cpu"
        },
        "work_dtype": {
          "enum": [
            "float32"
          ],
          "default": "float32"
        },
        "output_dtype": {
          "enum": [
            "preserve"
          ],
          "default": "preserve"
        },
        "boundary": {
          "enum": [
            "edge"
          ],
          "default": "edge"
        },
        "nearest": {
          "enum": [
            "floor",
            "half_pixel"
          ]
        },
        "antialias": {
          "type": "boolean"
        },
        "integer_rounding": {
          "enum": [
            "ties_to_even",
            "legacy_truncate"
          ]
        },
        "vector_epsilon": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "numeric_tolerance": {
          "type": "object",
          "properties": {
            "atol": {
              "type": "number",
              "minimum": 0
            },
            "rtol": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "atol",
            "rtol"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "backend",
        "versions",
        "nearest",
        "antialias",
        "integer_rounding",
        "vector_epsilon",
        "numeric_tolerance"
      ],
      "additionalProperties": false
    },
    "verification": {
      "enum": [
        "content",
        "metadata"
      ]
    }
  },
  "required": [
    "version",
    "recipe_digest",
    "bound_digest",
    "source_full_ids",
    "source_content",
    "input_digests",
    "output_digests",
    "input_shapes",
    "output_shapes",
    "operations",
    "execution",
    "verification"
  ],
  "additionalProperties": false
}
