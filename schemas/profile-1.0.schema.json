{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Euler profile 1.0",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "image",
        "depth",
        "mask",
        "ray_map",
        "intrinsics",
        "point_map",
        "point_cloud",
        "extrinsics",
        "generic"
      ]
    },
    "layout": {
      "enum": [
        "HW",
        "CHW",
        "HWC",
        "NHW",
        "NCHW",
        "NHWC",
        "matrix",
        "NC"
      ]
    },
    "shape": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        ]
      },
      "minItems": 2,
      "maxItems": 4
    },
    "dtype": {
      "enum": [
        "bool",
        "uint8",
        "uint16",
        "int16",
        "int32",
        "int64",
        "float32",
        "float64"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "invalid": {
      "type": "object",
      "properties": {
        "non_finite": {
          "type": "boolean"
        },
        "sentinel": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "non_finite",
        "sentinel"
      ],
      "additionalProperties": false
    },
    "image_plane": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "frame": {
      "type": "string",
      "minLength": 1
    },
    "depth_kind": {
      "enum": [
        "planar_z",
        "radial"
      ]
    },
    "normalization": {
      "enum": [
        "homogeneous",
        "unit",
        "none",
        "unit_or_zero"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "camera_model": {
      "enum": [
        "pinhole",
        "fisheye",
        "other"
      ]
    },
    "meaning": {
      "type": "string",
      "minLength": 1
    },
    "source_frame": {
      "type": "string",
      "minLength": 1
    },
    "target_frame": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "target_from_source",
        "source_from_target"
      ]
    }
  },
  "required": [
    "kind",
    "layout",
    "shape",
    "dtype",
    "unit",
    "invalid"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "image",
              "depth",
              "mask",
              "ray_map",
              "point_map",
              "intrinsics"
            ]
          }
        }
      },
      "then": {
        "required": [
          "image_plane"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "depth"
            ]
          }
        }
      },
      "then": {
        "required": [
          "depth_kind",
          "frame"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "ray_map",
              "point_map",
              "point_cloud"
            ]
          }
        }
      },
      "then": {
        "required": [
          "components",
          "frame"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "ray_map"
            ]
          }
        }
      },
      "then": {
        "required": [
          "normalization"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "mask"
            ]
          }
        }
      },
      "then": {
        "required": [
          "meaning"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "intrinsics"
            ]
          }
        }
      },
      "then": {
        "required": [
          "camera_model",
          "frame"
        ],
        "properties": {
          "layout": {
            "enum": [
              "matrix"
            ]
          },
          "shape": {
            "const": [
              3,
              3
            ]
          },
          "dtype": {
            "enum": [
              "float32",
              "float64"
            ]
          },
          "unit": {
            "enum": [
              "pixel"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "extrinsics"
            ]
          }
        }
      },
      "then": {
        "required": [
          "source_frame",
          "target_frame",
          "direction"
        ],
        "properties": {
          "layout": {
            "enum": [
              "matrix"
            ]
          },
          "shape": {
            "const": [
              4,
              4
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "point_cloud"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "layout": {
            "enum": [
              "NC"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "image",
              "depth",
              "mask",
              "ray_map",
              "point_map"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "layout": {
            "enum": [
              "HW",
              "CHW",
              "HWC",
              "NHW",
              "NCHW",
              "NHWC"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "HW"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shape": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "CHW"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shape": {
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "HWC"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shape": {
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "NHW"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shape": {
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "NCHW"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shape": {
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "NHWC"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shape": {
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "matrix"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shape": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "NC"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "shape": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  ]
}
